{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run dev)",
      "Bash(npm run build)",
      "Bash(npm run preview)",
      "Bash(npm run fetch-data)",
      "Edit(src/**)",
      "Edit(scripts/**)"
    ],
    "ask": [
      "Bash(npm run fetch-data -- --fresh)",
      "Bash(npm install *)",
      "Edit(public/data/**)"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Read(./.env)",
      "Read(./.env.*)"
    ]
  },
  "env": {
    "NODE_OPTIONS": "--max-old-space-size=4096"
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_input.file_path // .tool_response.filePath' | { read -r f; n=$(basename \"$f\"); osascript -e \"display notification \\\"Claude edited $n\\\" with title \\\"Claude Code hook\\\" sound name \\\"Glass\\\"\"; echo \"{\\\"systemMessage\\\": \\\"Hook fired: Claude edited $n\\\"}\"; } 2>/dev/null || true"
          }
        ]
      }
    ]
  }
}
